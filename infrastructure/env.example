# TrustOps Infrastructure Environment Configuration
# Copy this file to .env at the project root and customize for your deployment.
#
# After running `make deploy`, the deploy script auto-populates the S3 bucket
# names and DynamoDB table names from CloudFormation stack outputs.

# ──────────────────────────────────────────────────────────────────────
# Project
# ──────────────────────────────────────────────────────────────────────
PROJECT_NAME=trustops
ENVIRONMENT=dev

# ──────────────────────────────────────────────────────────────────────
# AWS Credentials & Region
# ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# AWS_PROFILE — Only set this if you want to use a named AWS CLI profile.
# Leave commented out when using environment variable credentials
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN) or
# IAM instance roles, as profile resolution takes precedence and can
# silently route requests to the wrong account.
# AWS_PROFILE=default

# ──────────────────────────────────────────────────────────────────────
# S3 Buckets (REQUIRED — no defaults)
#
# Set these to the bucket names from your deployment outputs. There are
# deliberately no fallback defaults: S3 bucket names are globally unique,
# so a predictable default could be created by another account. The
# framework raises a configuration error rather than guessing.
#
# Convention: trustops-<purpose>-<env>-<deploymentId>-<ACCOUNT_ID>
# These are auto-populated by deploy.sh after stack creation.
# ──────────────────────────────────────────────────────────────────────
TRUSTOPS_DATASETS_BUCKET=
TRUSTOPS_RESULTS_BUCKET=
TRUSTOPS_ARTIFACTS_BUCKET=

# ──────────────────────────────────────────────────────────────────────
# DynamoDB Tables
#
# All 7 tables are created by CloudFormation with a DeploymentId suffix.
# These are auto-populated by deploy.sh after stack creation.
# ──────────────────────────────────────────────────────────────────────
# TRUSTOPS_WORKFLOWS_TABLE=trustops-workflows
# TRUSTOPS_MODELS_TABLE=trustops-models
# TRUSTOPS_DATASET_VERSIONS_TABLE=trustops-dataset-versions
# TRUSTOPS_DATASET_LINEAGE_TABLE=trustops-dataset-lineage
# TRUSTOPS_RESULTS_TABLE=trustops-results
# TRUSTOPS_EVALUATIONS_TABLE=trustops-evaluations
# TRUSTOPS_FINE_TUNING_JOBS_TABLE=trustops-fine-tuning-jobs

# ──────────────────────────────────────────────────────────────────────
# Deployment
# ──────────────────────────────────────────────────────────────────────
DEPLOYMENT_METHOD=cloudformation

# Alarm Notifications (optional — leave empty to skip)
ALERT_EMAIL=

# ──────────────────────────────────────────────────────────────────────
# Bedrock Knowledge Base (optional)
#
# Set after deploying the Terraform Knowledge Base stack.
# Without these, semantic similarity runs in mock mode (fine for testing).
# ──────────────────────────────────────────────────────────────────────
# KNOWLEDGE_BASE_ID=
# KNOWLEDGE_BASE_DATA_SOURCE_ID=

# ──────────────────────────────────────────────────────────────────────
# Model Defaults
# ──────────────────────────────────────────────────────────────────────
DEFAULT_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
DEFAULT_FOUNDATION_MODEL=amazon.nova-lite-v1:0

# ──────────────────────────────────────────────────────────────────────
# Lambda Configuration
# ──────────────────────────────────────────────────────────────────────
LAMBDA_TIMEOUT=900
LAMBDA_MEMORY=3008

# ──────────────────────────────────────────────────────────────────────
# CloudWatch
# ──────────────────────────────────────────────────────────────────────
# TRUSTOPS_LOG_GROUP=/aws/trustops
LOG_RETENTION_DAYS=365

# ──────────────────────────────────────────────────────────────────────
# Trust Scoring
# ──────────────────────────────────────────────────────────────────────
TRUST_SCORE_THRESHOLD=0.7
# HALLUCINATION_SIMILARITY_THRESHOLD=0.7

# ──────────────────────────────────────────────────────────────────────
# Fine-Tuning
# ──────────────────────────────────────────────────────────────────────
# BEDROCK_EXECUTION_ROLE_ARN=

# ──────────────────────────────────────────────────────────────────────
# Terraform Backend (required for team use)
# Supplied via `terraform init -backend-config=backend.hcl`
# ──────────────────────────────────────────────────────────────────────
# TERRAFORM_BACKEND_BUCKET=trustops-terraform-state-<ACCOUNT_ID>-<REGION>
# TERRAFORM_BACKEND_DYNAMODB_TABLE=trustops-terraform-locks
