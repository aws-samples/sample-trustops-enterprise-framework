# TrustOps Infrastructure Environment Configuration
# Copy this file to .env and customize for your deployment

# Project Configuration
PROJECT_NAME=trustops
ENVIRONMENT=dev

# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default

# S3 Buckets (REQUIRED - no defaults)
#
# Set these to the bucket names from your deployment outputs. There are
# deliberately no fallback defaults: S3 bucket names are globally unique, so a
# predictable default could be created by another account, and a misconfigured
# deployment would then read from or write to a bucket they control. The
# framework raises a configuration error rather than guessing.
#
# Convention: trustops-<purpose>-<ACCOUNT_ID>-<REGION>
TRUSTOPS_DATASETS_BUCKET=
TRUSTOPS_RESULTS_BUCKET=
TRUSTOPS_ARTIFACTS_BUCKET=

# DynamoDB Tables (optional - defaults are account-scoped, so not squattable)
# TRUSTOPS_WORKFLOWS_TABLE=
# TRUSTOPS_MODELS_TABLE=

# Deployment Method (cloudformation or terraform)
DEPLOYMENT_METHOD=cloudformation

# Alarm Notifications (optional - leave empty to skip)
ALERT_EMAIL=

# Bedrock Knowledge Base (set after initial deployment)
# KNOWLEDGE_BASE_ID=
# KNOWLEDGE_BASE_DATA_SOURCE_ID=

# Lambda Configuration
LAMBDA_EVALUATION_TIMEOUT=900
LAMBDA_EVALUATION_MEMORY=1024
LAMBDA_TRUST_SCORING_TIMEOUT=300
LAMBDA_TRUST_SCORING_MEMORY=512

# CloudWatch Configuration
# Minimum 365 days; the Terraform variable enforces this floor for audit
# compliance, and production deployments retain for 1096 days.
LOG_RETENTION_DAYS=365

# Trust Scoring Configuration
TRUST_SCORE_THRESHOLD=0.7

# Terraform Backend (required for team use)
# Supplied via `terraform init -backend-config=backend.hcl`; see
# infrastructure/terraform/backend.hcl.example.
# TERRAFORM_BACKEND_BUCKET=trustops-terraform-state-<ACCOUNT_ID>-<REGION>
# TERRAFORM_BACKEND_DYNAMODB_TABLE=trustops-terraform-locks
